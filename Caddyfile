{
    admin off
    default_sni {$APP_DOMAIN}
}

# ── HTTPS (self-signed internal TLS) ──────────────────────────────────────
https://{$APP_DOMAIN} {

    tls /certs/cert.pem /certs/key.pem

    # ── Security headers ───────────────────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        X-Content-Type-Options   "nosniff"
        X-Frame-Options          "DENY"
        X-XSS-Protection         "1; mode=block"
        Referrer-Policy          "strict-origin-when-cross-origin"
        Permissions-Policy       "camera=(), microphone=(), geolocation=()"
        # Strip server fingerprinting
        -Server
        -X-Powered-By
    }

    # ── API → FastAPI backend ──────────────────────────────────────────────
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP        {remote_host}

            header_up X-Forwarded-Proto https
        }
    }

    # ── Server Status Report ───────────────────────────────────────────────
    handle /server-report {
        redir /server-report/ 301
    }
    handle /server-report/* {
        uri strip_prefix /server-report
        reverse_proxy 172.22.0.1:8888
    }

    # ── SPA → nginx frontend container ────────────────────────────────────
    handle {
        reverse_proxy frontend:80
    }

    # ── Access log (rolled at 10 MB, keep last 5) ──────────────────────────
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }

}

# Internal IP access
https://10.10.108.68 {
    tls /certs/cert.pem /certs/key.pem

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        X-Content-Type-Options   "nosniff"
        X-Frame-Options          "DENY"
        X-XSS-Protection         "1; mode=block"
        Referrer-Policy          "strict-origin-when-cross-origin"
        Permissions-Policy       "camera=(), microphone=(), geolocation=()"
        -Server
        -X-Powered-By
    }

    # ── API → FastAPI backend (was missing entirely — every API call silently
    # fell through to the frontend container instead of the backend) ─────────
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP        {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /server-report {
        redir /server-report/ 301
    }
    handle /server-report/* {
        uri strip_prefix /server-report
        reverse_proxy 172.22.0.1:8888
    }
    handle {
        reverse_proxy frontend:80
    }
}
